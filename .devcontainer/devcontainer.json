{
  "name": "Someday Studio",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:18",

  // npm install brings in firebase-tools and netlify-cli from devDependencies
  "postCreateCommand": "npm install",

  // Ports forwarded automatically by Codespaces
  "forwardPorts": [8888, 9099, 9000],

  "portsAttributes": {
    "8888": {
      // Studio UI: private (only accessible to authenticated GitHub user).
      // Auth and RTDB emulators are proxied through this port — no other
      // port needs to be opened to the network.
      "label": "Studio UI (netlify dev)",
      "onAutoForward": "notify"
    },
    "9099": {
      // Auth emulator: private. Requests from the browser are proxied via
      // port 8888 (see netlify.toml), not sent directly to this port.
      "label": "Firebase Auth Emulator",
      "onAutoForward": "silent"
    },
    "9000": {
      // RTDB emulator: private. Browser never connects directly — data is
      // loaded via the studio-data Netlify Function (Admin SDK, server-side).
      "label": "Firebase RTDB Emulator",
      "onAutoForward": "silent"
    }
  },

  "remoteUser": "node"
}
