{
  "name": "Someday Studio",

  // Custom image: Node.js 22 LTS + Java 21 JRE (for Firebase emulators).
  // Built from .devcontainer/Dockerfile — no external feature registries needed.
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Installs firebase-tools, netlify-cli, firebase-admin, jest from package.json.
  // --include=dev ensures devDependencies are installed regardless of NODE_ENV.
  "postCreateCommand": "npm install --include=dev",

  // Ports forwarded automatically by Codespaces — all private.
  "forwardPorts": [8888, 9099, 9000],

  "portsAttributes": {
    "8888": {
      // Studio UI served by Netlify Dev.
      // Auth goes to /.netlify/functions/studio-auth (server-side, no proxy).
      "label": "Studio UI (netlify dev)",
      "onAutoForward": "notify"
    },
    "9099": {
      // Firebase Auth Emulator — private, accessed server-side only.
      "label": "Firebase Auth Emulator",
      "onAutoForward": "silent"
    },
    "9000": {
      // Firebase RTDB Emulator — private, accessed server-side only.
      "label": "Firebase RTDB Emulator",
      "onAutoForward": "silent"
    }
  },

  "remoteUser": "node"
}
