{
  "name": "someday",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "jest tests/ --testPathIgnorePatterns=tests/integration",
    "test:integration": "firebase emulators:exec --only auth,database --project demo-vivo-test \"jest tests/integration --runInBand\"",
    "test:rules": "firebase emulators:exec --only database --project vivo-mvp-rules-test \"jest tests/integration/database-rules.integration.test.js --forceExit\"",
    "studio:local": "node scripts/start-studio-local.js",
    "studio:seed": "node scripts/seed-emulator-suggestion.js",
    "studio:seed-brunch": "node scripts/seed-brunch-club.js"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "resend": "^3.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.34.1",
    "jest": "^29.7.0",
    "netlify-cli": "^17.0.0"
  }
}
