{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
      }
    },
    "events": {
      "$eventId": {
        ".read": "auth != null && (data.child('createdBy').val() === auth.uid || root.child('invites').child(auth.uid).child($eventId).val() === true || root.child('userEvents').child(auth.uid).child($eventId).val() !== null || auth.token.grantedEvent === $eventId)",
        ".write": false
      }
    },
    "userEvents": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": false
      }
    },
    "invites": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": false
      }
    },
    "inviteTokens": {
      ".read": false,
      ".write": false
    },
    "friends": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": false
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": false
      }
    },
    "spaces": {
      ".read": false,
      "$spaceId": {
        ".write": false
      }
    },
    "spaceEvents": {
      ".read": false,
      "$spaceId": {
        ".write": false
      }
    },
    "userSpaces": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": false
      }
    },
    "notifications": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": false
      }
    },
    "activities": {
      ".read": true,
      ".write": false
    },
    "providers": {
      ".read": "auth != null && auth.token.studioRole != null",
      ".write": false
    },
    "suggestions": {
      ".read": "auth != null && auth.token.studioRole != null",
      "$id": {
        ".write": false
      }
    },
    "suggestionHashes": {
      ".read": "auth != null && auth.token.studioRole != null",
      ".write": false
    },
    "studioAuditLog": {
      ".read": "auth != null && (auth.token.studioRole === 'editor' || auth.token.studioRole === 'superadmin')",
      ".write": false
    },
    "studioAdminUsers": {
      ".read": "auth != null && auth.token.studioRole === 'superadmin'",
      ".write": false
    }
  }
}
